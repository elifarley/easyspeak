msgid "1-9 or chains like '3 7 5' - zoom to zone(s)"
msgstr "1-9 ou des suites comme '3 7 5' - zoomer sur la zone"

msgid "Grid"
msgstr "Grille"

msgid "Grid closed"
msgstr "Grille fermée"

msgid "I couldn't move the pointer."
msgstr "Je n'ai pas pu déplacer le pointeur."

msgid "I tried, but I'm not sure it worked."
msgstr "J'ai essayé, mais je ne suis pas sûr que cela ait fonctionné."

msgid "again - reopen at the last spot"
msgstr "again - rouvrir au dernier endroit"

msgid "click - left click"
msgstr "click - clic gauche"

msgid "close/cancel - hide the grid"
msgstr "close/cancel - masquer la grille"

msgid "grid/mouse/pointer/cursor - show mouse grid"
msgstr "grid/mouse/pointer/cursor - afficher la grille de la souris"

msgid "right click / double click / middle click"
msgstr "right click / double click / middle click - clic droit, double, du milieu"
