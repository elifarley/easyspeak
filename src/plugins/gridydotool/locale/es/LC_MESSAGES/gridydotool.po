msgid "1-9 or chains like '3 7 5' - zoom to zone(s)"
msgstr "1-9 o cadenas como '3 7 5' - ampliar la zona"

msgid "Grid"
msgstr "Cuadrícula"

msgid "Grid closed"
msgstr "Cuadrícula cerrada"

msgid "I couldn't move the pointer."
msgstr "No he podido mover el puntero."

msgid "I tried, but I'm not sure it worked."
msgstr "Lo intenté, pero no estoy seguro de que haya funcionado."

msgid "again - reopen at the last spot"
msgstr "again - reabrir en el último punto"

msgid "click - left click"
msgstr "click - clic izquierdo"

msgid "close/cancel - hide the grid"
msgstr "close/cancel - ocultar la cuadrícula"

msgid "grid/mouse/pointer/cursor - show mouse grid"
msgstr "grid/mouse/pointer/cursor - mostrar la cuadrícula del ratón"

msgid "right click / double click / middle click"
msgstr "right click / double click / middle click - clic derecho, doble, central"
