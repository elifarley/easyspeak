msgid "1-9 or chains like '3 7 5' - zoom to zone(s)"
msgstr "1-9 o sequenze come '3 7 5' - ingrandisce la zona"

msgid "Grid"
msgstr "Griglia"

msgid "Grid closed"
msgstr "Griglia chiusa"

msgid "I couldn't move the pointer."
msgstr "Non sono riuscito a spostare il puntatore."

msgid "I tried, but I'm not sure it worked."
msgstr "Ci ho provato, ma non sono sicuro che abbia funzionato."

msgid "again - reopen at the last spot"
msgstr "again - riapre nell'ultimo punto"

msgid "click - left click"
msgstr "click - clic sinistro"

msgid "close/cancel - hide the grid"
msgstr "close/cancel - nasconde la griglia"

msgid "grid/mouse/pointer/cursor - show mouse grid"
msgstr "grid/mouse/pointer/cursor - mostra la griglia del mouse"

msgid "right click / double click / middle click"
msgstr "right click / double click / middle click - clic destro, doppio, centrale"
