msgid "1-9 or chains like '3 7 5' - zoom to zone(s)"
msgstr "1-9 oder Folgen wie '3 7 5' - in Zone(n) zoomen"

msgid "Grid"
msgstr "Raster"

msgid "Grid closed"
msgstr "Raster geschlossen"

msgid "I couldn't move the pointer."
msgstr "Ich konnte den Zeiger nicht bewegen."

msgid "I couldn't show the grid."
msgstr "Ich konnte das Raster nicht anzeigen."

msgid "I tried, but I'm not sure it worked."
msgstr "Ich habe es versucht, aber ich bin nicht sicher, ob es geklappt hat."

msgid "again - reopen at the last spot"
msgstr "again - an der letzten Stelle wieder öffnen"

msgid "click - left click"
msgstr "click - Linksklick"

msgid "close/cancel - hide the grid"
msgstr "close/cancel - Raster ausblenden"

msgid "grid/mouse/pointer/cursor - show mouse grid"
msgstr "grid/mouse/pointer/cursor - Mausraster anzeigen"

msgid "right click / double click / middle click"
msgstr "right click / double click / middle click - Rechts-, Doppel-, Mittelklick"
